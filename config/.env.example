# Скопировать в корень репозитория как .env и заполнить.
# Файл .env в репозиторий не коммитится (см. .gitignore).

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=autoschool
POSTGRES_USER=autoschool
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SMS-шлюз для одноразовых кодов входа в веб-панель (ТЗ 3.1.1.3)
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# Push-уведомления (сервис доставки определяется на этапе 2)
PUSH_PROVIDER_CREDENTIALS=
